          <material>
            <ambient>0.42 0.62 0.38 1</ambient>
            <diffuse>0.42 0.62 0.38 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="steep_slope_blocking">
      <static>true</static>
      <link name="steep_ramp">
        <pose>3.5 9.0 0.42 0 -0.48 0</pose>
        <collision name="collision">
          <geometry><box><size>3.8 3.0 0.14</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3.8 3.0 0.14</size></box></geometry>
          <material>
