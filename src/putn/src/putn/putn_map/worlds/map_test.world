<?xml version="1.0"?>
<sdf version="1.6">
  <world name="putn_test_terrain">
    <include>
      <uri>model://sun</uri>
    </include>

    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <model name="segmented_floor_with_pit">
      <static>true</static>

      <!-- Four floor slabs leave a real 3 m x 3 m opening for the pit. -->
      <link name="west_floor">
        <pose>-7.25 0 -0.04 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>25.5 40.0 0.08</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>25.5 40.0 0.08</size></box></geometry>
          <material>
            <ambient>0.62 0.62 0.55 1</ambient>
            <diffuse>0.62 0.62 0.55 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="east_floor">
        <pose>14.25 0 -0.04 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>11.5 40.0 0.08</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>11.5 40.0 0.08</size></box></geometry>
          <material>
            <ambient>0.62 0.62 0.55 1</ambient>
            <diffuse>0.62 0.62 0.55 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="north_floor">
        <pose>7.0 8.75 -0.04 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>3.0 22.5 0.08</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3.0 22.5 0.08</size></box></geometry>
          <material>
            <ambient>0.62 0.62 0.55 1</ambient>
            <diffuse>0.62 0.62 0.55 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="south_floor">
        <pose>7.0 -12.75 -0.04 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>3.0 14.5 0.08</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3.0 14.5 0.08</size></box></geometry>
          <material>
            <ambient>0.62 0.62 0.55 1</ambient>
            <diffuse>0.62 0.62 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="gentle_undulation_passable">
      <static>true</static>
      <link name="ramp_up">
        <pose>1.8 4.0 0.08 0 -0.08 0</pose>
        <collision name="collision">
          <geometry><box><size>2.2 3.2 0.08</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.2 3.2 0.08</size></box></geometry>
          <material>
            <ambient>0.42 0.62 0.38 1</ambient>
            <diffuse>0.42 0.62 0.38 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="low_plateau">
        <pose>4.0 4.0 0.13 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>2.2 3.2 0.10</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.2 3.2 0.10</size></box></geometry>
          <material>
            <ambient>0.38 0.58 0.34 1</ambient>
            <diffuse>0.38 0.58 0.34 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="ramp_down">
        <pose>6.2 4.0 0.08 0 0.08 0</pose>
        <collision name="collision">
          <geometry><box><size>2.2 3.2 0.08</size></box></geometry>
        </collision>
        <visual name="visual">
