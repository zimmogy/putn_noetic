        <visual name="visual">
          <geometry><cylinder><radius>0.35</radius><length>1.3</length></cylinder></geometry>
          <material><ambient>0.55 0.08 0.08 1</ambient><diffuse>0.55 0.08 0.08 1</diffuse></material>
