        <pose>7.0 -5.55 -0.42 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>3.1 0.1 0.84</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3.1 0.1 0.84</size></box></geometry>
          <material><ambient>0.32 0.25 0.20 1</ambient><diffuse>0.32 0.25 0.20 1</diffuse></material>
