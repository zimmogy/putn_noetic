    <model name="column_obstacles">
      <static>true</static>
      <link name="column_1">
        <pose>10.5 2.0 0.65 0 0 0</pose>
        <collision name="collision">
          <geometry><cylinder><radius>0.35</radius><length>1.3</length></cylinder></geometry>
