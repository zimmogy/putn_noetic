<?xml version="1.0"?>
<sdf version="1.6">
  <world name="putn_random_pit_column_test">
    <include>
      <uri>model://sun</uri>
    </include>

    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <model name="compact_floor_with_pit_openings">
      <static>true</static>

      <!-- Compact 16 m x 16 m test field. Floor slabs leave three real pit openings. -->
      <link name="south_floor">
        <pose>0 -6 -0.04 0 0 0</pose>
        <collision name="collision"><geometry><box><size>16.0 4.0 0.08</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>16.0 4.0 0.08</size></box></geometry><material><ambient>0.58 0.58 0.52 1</ambient><diffuse>0.58 0.58 0.52 1</diffuse></material></visual>
      </link>

      <link name="middle_floor">
        <pose>0 -0.2 -0.04 0 0 0</pose>
        <collision name="collision"><geometry><box><size>16.0 4.4 0.08</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>16.0 4.4 0.08</size></box></geometry><material><ambient>0.58 0.58 0.52 1</ambient><diffuse>0.58 0.58 0.52 1</diffuse></material></visual>
      </link>

      <link name="north_floor">
        <pose>0 5.8 -0.04 0 0 0</pose>
        <collision name="collision"><geometry><box><size>16.0 4.4 0.08</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>16.0 4.4 0.08</size></box></geometry><material><ambient>0.58 0.58 0.52 1</ambient><diffuse>0.58 0.58 0.52 1</diffuse></material></visual>
      </link>

      <link name="south_pit_row_left_floor">
        <pose>-3.55 -3.2 -0.04 0 0 0</pose>
        <collision name="collision"><geometry><box><size>8.9 1.6 0.08</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>8.9 1.6 0.08</size></box></geometry><material><ambient>0.58 0.58 0.52 1</ambient><diffuse>0.58 0.58 0.52 1</diffuse></material></visual>
      </link>

      <link name="south_pit_row_right_floor">
        <pose>5.35 -3.2 -0.04 0 0 0</pose>
        <collision name="collision"><geometry><box><size>10.6 1.6 0.08</size></box></geometry></collision>
