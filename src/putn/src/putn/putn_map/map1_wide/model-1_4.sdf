<?xml version="1.0"?>
<sdf version="1.4">
  <model name="Map1Wide">
    <static>true</static>
    <link name="link">
      <pose>0 0 0 0 0 0</pose>
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://map1/meshes/map1.dae</uri>
            <scale>1.0 1.0 0.5</scale>
          </mesh>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://map1/meshes/map1.dae</uri>
            <scale>1.0 1.0 0.5</scale>
          </mesh>
        </geometry>
        <material>
          <script>
            <uri>model://map1/materials/scripts</uri>
            <uri>model://map1/materials/textures</uri>
            <name>Map1/Image</name>
          </script>
        </material>
      </visual>
    </link>

    <!-- Keep the original terrain unchanged and append flat, traversable
         platforms on +X, -X and -Y. The original mesh spans about [-10, 10]
         in X/Y; each extension is 3 m wide with its top surface at z=0. -->
    <link name="positive_x_extension">
      <pose>11.5 0 -0.05 0 0 0</pose>
      <collision name="collision">
        <geometry><box><size>3.0 20.0 0.1</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>3.0 20.0 0.1</size></box></geometry>
        <material><ambient>0.55 0.53 0.45 1</ambient><diffuse>0.55 0.53 0.45 1</diffuse></material>
      </visual>
    </link>

    <link name="negative_x_extension">
      <pose>-11.5 0 -0.05 0 0 0</pose>
      <collision name="collision">
        <geometry><box><size>3.0 20.0 0.1</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>3.0 20.0 0.1</size></box></geometry>
        <material><ambient>0.55 0.53 0.45 1</ambient><diffuse>0.55 0.53 0.45 1</diffuse></material>
      </visual>
    </link>

    <link name="negative_y_extension">
      <pose>0 -11.5 -0.05 0 0 0</pose>
      <collision name="collision">
        <geometry><box><size>26.0 3.0 0.1</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>26.0 3.0 0.1</size></box></geometry>
        <material><ambient>0.55 0.53 0.45 1</ambient><diffuse>0.55 0.53 0.45 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
