<launch>
  <arg name="config_path" default="$(find putn_launch)/config/map_test_nav_eval.yaml"/>
  <arg name="output_dir" default="$(env HOME)/.ros/putn_nav_eval"/>
  <arg name="method" default="lesta_putn"/>
  <arg name="robot_model_name" default="scout/"/>
  <arg name="goal_topic" default="/goal"/>
  <arg name="cmd_vel_topic" default="/cmd_vel"/>
  <arg name="model_states_topic" default="/gazebo/model_states"/>
  <arg name="global_path_topic" default="/global_planning_node/global_path"/>
  <arg name="fused_cloud_topic" default="/global_planning_node/fused_traversability_cloud"/>
  <arg name="reset_settle_s" default="3.0"/>
  <arg name="path_grace_s" default="20.0"/>
  <arg name="risk_sample_radius_m" default="0.75"/>
  <arg name="enable_cmd_follower" default="true"/>
  <arg name="max_linear_speed" default="0.45"/>
  <arg name="max_angular_speed" default="0.8"/>

  <node pkg="putn_launch" type="run_map_test_nav_eval.py" name="map_test_nav_eval" output="screen">
    <param name="config_path" value="$(arg config_path)"/>
    <param name="output_dir" value="$(arg output_dir)"/>
    <param name="method" value="$(arg method)"/>
    <param name="robot_model_name" value="$(arg robot_model_name)"/>
    <param name="goal_topic" value="$(arg goal_topic)"/>
    <param name="cmd_vel_topic" value="$(arg cmd_vel_topic)"/>
    <param name="model_states_topic" value="$(arg model_states_topic)"/>
    <param name="global_path_topic" value="$(arg global_path_topic)"/>
    <param name="fused_cloud_topic" value="$(arg fused_cloud_topic)"/>
    <param name="reset_settle_s" value="$(arg reset_settle_s)"/>
    <param name="path_grace_s" value="$(arg path_grace_s)"/>
    <param name="risk_sample_radius_m" value="$(arg risk_sample_radius_m)"/>
    <param name="enable_cmd_follower" value="$(arg enable_cmd_follower)"/>
    <param name="max_linear_speed" value="$(arg max_linear_speed)"/>
    <param name="max_angular_speed" value="$(arg max_angular_speed)"/>
  </node>
</launch>
