<launch>
  <arg name="scene" default="map1_wide"/>
  <arg name="warmup_coordinate_scale" default="1.0"/>
  <arg name="use_lesta" default="true"/>
  <arg name="lesta_model_path" default="/home/whr/Data/test_pt/proposed/epoch_best.pt"/>
  <!-- The deployed checkpoint was trained on RELLIS-3D rather than Gazebo.
       Use a conservative zero-shot fusion until simulation-domain probability
       calibration demonstrates that a larger LeSTA contribution is safe. -->
  <arg name="lesta_putn_weight" default="0.75"/>
  <arg name="lesta_weight" default="0.25"/>
  <arg name="lesta_unknown_penalty" default="0.0"/>
  <arg name="lesta_risk_threshold" default="0.70"/>
  <arg name="lesta_fusion_policy" default="risk_floor_weighted"/>
  <arg name="lesta_map_source" default="mapping"/>
  <arg name="require_lesta_ready" default="true"/>
  <arg name="lesta_readiness_timeout_s" default="30.0"/>
  <arg name="lesta_map_topic" default="$(eval '/lesta/mapping/traversability_grid_map' if arg('lesta_map_source') == 'mapping' else '/lesta/prediction/traversability')"/>
  <!-- Keep LeSTA mapping for full-map coverage, but fuse its instantaneous
       output so repeated observations cannot saturate confidence to 0.95. -->
  <arg name="lesta_probability_layer" default="traversability/probability"/>
  <arg name="lesta_binary_layer" default="traversability/binary"/>
  <arg name="launch_local_control" default="false"/>
  <arg name="enable_map_blind_spot_patch" default="true"/>
  <arg name="task_id" default="single_start_goal"/>
  <arg name="runs" default="1"/>
  <arg name="start_x" default="0.0"/>
  <arg name="start_y" default="0.0"/>
  <arg name="start_z" default="0.0"/>
  <arg name="start_label" default="O"/>
  <!-- Keep the simulator's cold-start location independent from the formal
       evaluation start.  This lets non-O cases warm the map from O first and
       navigate to their requested start without teleporting or SLAM jumps. -->
  <arg name="simulation_spawn_x" default="$(arg start_x)"/>
  <arg name="simulation_spawn_y" default="$(arg start_y)"/>
  <arg name="simulation_spawn_z" default="$(arg start_z)"/>
  <arg name="spawn_z_offset" default="1.0"/>
  <arg name="spawn_yaw" default="0.0"/>
  <arg name="goal_x" default="8.4"/>
  <arg name="goal_y" default="7.7"/>
  <arg name="goal_z" default="0.0"/>
  <arg name="goal_label" default="A"/>

  <arg name="config_path" default="$(find putn_launch)/config/map_test_nav_eval.yaml"/>
  <arg name="output_dir" default="$(env HOME)/.ros/putn_nav_eval"/>
  <arg name="method" default="auto"/>
  <!-- Optional per-session diagnostic recording. Because the recorder belongs
       to this launch, every isolated simulator relaunch starts a new timestamped
       bag automatically and closes it together with the current session. The
       parent directory of diagnostic_bag_prefix must already exist. -->
  <arg name="record_diagnostic_bag" default="false"/>
  <arg name="diagnostic_bag_prefix" default="$(env HOME)/.ros/map_test_nav_diagnostic"/>
  <arg name="diagnostic_bag_split_size_mb" default="4096"/>
  <arg name="diagnostic_bag_buffsize_mb" default="1024"/>
  <arg name="initial_delay_s" default="15.0"/>
  <!-- Navigate between episode endpoints; Gazebo teleport desynchronizes A-LOAM. -->
  <arg name="start_mode" default="navigate"/>
  <arg name="reposition_timeout_s" default="180.0"/>
  <arg name="navigation_timeout_s" default="180.0"/>
  <arg name="pre_goal_warmup_s" default="0.0"/>
  <arg name="warmup_mode" default="coverage_waypoints"/>
  <!-- Only leave the LiDAR blind spot with a short clockwise arc. Full warmup
       uses the explicit safe B-C-D-A waypoints from map_test_nav_eval.yaml. -->
  <arg name="warmup_cmd_sequence" default="0.08,-0.35,3.0;0.00,0.35,3.0"/>
  <arg name="warmup_reset_to_start" default="false"/>
  <arg name="warmup_end_requires_start" default="true"/>
  <arg name="warmup_once" default="true"/>
  <arg name="warmup_bootstrap_enabled" default="true"/>
  <arg name="warmup_bootstrap_min_displacement_m" default="0.08"/>
  <arg name="projection_recovery_distances_m" default="1.0,-1.55,1.0,-1.95"/>
  <arg name="projection_recovery_speed_mps" default="0.12"/>
  <arg name="projection_recovery_map_settle_s" default="3.0"/>
  <arg name="projection_recovery_scan_angle_deg" default="35.0"/>
  <arg name="bidirectional" default="true"/>
  <arg name="session_direction_order_policy" default="balanced"/>
  <!-- Algorithm comparison defaults to one formal attempt per fully warmed
       simulator session. Set 0 only for a separate endurance campaign. -->
  <arg name="max_episode_attempts_per_session" default="1"/>
  <arg name="rrt_settle_s" default="8.0"/>
  <arg name="warmup_waypoint_spacing_m" default="2.0"/>
  <arg name="warmup_waypoint_timeout_s" default="35.0"/>
  <arg name="warmup_waypoint_retries" default="1"/>
  <arg name="warmup_no_progress_timeout_s" default="10.0"/>
  <arg name="warmup_min_progress_m" default="0.15"/>
  <arg name="warmup_path_stale_s" default="3.0"/>
  <arg name="warmup_total_timeout_s" default="720.0"/>
  <arg name="warmup_target_coverage_ratio" default="0.80"/>
  <arg name="enable_heading_recovery" default="true"/>
  <arg name="heading_recovery_trigger_s" default="12.0"/>
  <arg name="heading_recovery_angles_deg" default="35,-70,105,-140"/>
  <arg name="heading_recovery_speed" default="2.0"/>
  <arg name="lookahead_distance_m" default="0.70"/>
  <arg name="path_switch_min_interval_s" default="1.5"/>
  <arg name="path_max_hold_s" default="3.0"/>
  <arg name="path_switch_max_heading_deg" default="55.0"/>
  <arg name="active_path_end_distance_m" default="0.60"/>
  <arg name="active_path_max_cross_track_m" default="0.80"/>
  <arg name="path_origin_max_error_m" default="2.0"/>
  <arg name="control_pose_source" default="tf"/>
  <arg name="localization_drift_fail_m" default="1.0"/>
  <arg name="localization_drift_hold_s" default="2.0"/>
  <!-- Excluded setup/localization records are retried until the eligible quota is full. -->
  <!-- A failed excluded setup attempt usually means the current SLAM session
       is no longer safe for another cross-map reposition. Save and restart. -->
  <arg name="abort_on_start_setup_failure" default="true"/>
  <arg name="max_excluded_retries_per_direction" default="10"/>
  <!-- Persist incomplete sample quotas across full simulator restarts. -->
  <arg name="resume_incomplete_campaign" default="true"/>
  <arg name="campaign_id" default=""/>
  <!-- Optional one-time import of a partial episodes CSV created before checkpoints existed. -->
  <arg name="campaign_seed_csv" default=""/>
  <!-- Isolate PUTN navigation performance from accumulated A-LOAM frame drift. -->
  <arg name="compensate_goals_with_ground_truth" default="true"/>
  <arg name="abort_on_localization_drift" default="false"/>
  <!-- Goal compensation may absorb small frame drift, but a persistent 4 m
       mismatch invalidates physical navigation and requires a clean restart. -->
  <arg name="abort_session_on_severe_localization_drift" default="true"/>
  <arg name="severe_localization_drift_fail_m" default="4.0"/>
  <arg name="severe_localization_drift_hold_s" default="3.0"/>
  <arg name="tilt_fail_hold_s" default="0.8"/>
  <arg name="severe_tilt_fail_deg" default="50.0"/>
  <arg name="goal_compensation_refresh_distance_m" default="0.60"/>
  <!-- Kept for diagnostics/backward compatibility; yaw alone no longer refreshes a point goal. -->
  <arg name="goal_compensation_refresh_yaw_deg" default="3.0"/>
  <arg name="goal_compensation_refresh_min_interval_s" default="8.0"/>
  <arg name="goal_compensation_max_refreshes" default="12"/>
  <arg name="goal_compensation_max_forced_refreshes" default="3"/>
  <arg name="goal_compensation_forced_min_progress_m" default="0.15"/>
  <arg name="control_goal_tolerance_m" default="0.30"/>
  <arg name="control_goal_mismatch_physical_error_m" default="1.0"/>
  <arg name="control_goal_mismatch_hold_s" default="2.0"/>
  <arg name="physical_stuck_displacement_m" default="0.12"/>
  <arg name="physical_stuck_hold_s" default="12.0"/>
  <arg name="physical_stuck_max_recoveries" default="2"/>
  <arg name="pre_episode_health_timeout_s" default="8.0"/>
  <arg name="pre_episode_health_hold_s" default="1.0"/>
  <arg name="pre_episode_max_tilt_deg" default="25.0"/>
  <!-- Reject a degraded localization state before an isolated formal sample. -->
  <arg name="pre_episode_max_tf_gazebo_offset_m" default="2.5"/>
  <arg name="pre_episode_max_sensor_age_s" default="2.0"/>
  <arg name="post_episode_health_check" default="true"/>
  <arg name="lesta_map_max_age_s" default="5.0"/>
  <arg name="max_consecutive_planning_failures_before_restart" default="2"/>
  <arg name="runtime_metric_sample_period_s" default="0.10"/>
  <arg name="runtime_metric_max_step_m" default="1.0"/>
  <arg name="max_angular_speed" default="2.0"/>
  <arg name="require_exclusive_cmd_vel" default="true"/>
  <arg name="allow_reverse_following" default="false"/>
  <arg name="reverse_heading_threshold_deg" default="100.0"/>
  <arg name="reverse_exit_threshold_deg" default="85.0"/>
  <arg name="min_follow_linear_speed" default="0.10"/>
  <arg name="min_follow_angular_speed" default="0.20"/>
  <arg name="min_turn_in_place_angular_speed" default="2.0"/>
  <arg name="rotate_in_place_threshold_deg" default="55.0"/>
  <arg name="rotate_in_place_exit_threshold_deg" default="20.0"/>
  <arg name="max_moving_angular_speed" default="0.55"/>
  <arg name="shutdown_on_completion" default="true"/>

  <include file="$(find putn_launch)/launch/simulation.launch">
    <arg name="scene" value="$(arg scene)"/>
    <arg name="use_lesta" value="$(arg use_lesta)"/>
    <arg name="lesta_model_path" value="$(arg lesta_model_path)"/>
    <arg name="lesta_putn_weight" value="$(arg lesta_putn_weight)"/>
    <arg name="lesta_weight" value="$(arg lesta_weight)"/>
    <arg name="lesta_unknown_penalty" value="$(arg lesta_unknown_penalty)"/>
    <arg name="lesta_risk_threshold" value="$(arg lesta_risk_threshold)"/>
    <arg name="lesta_fusion_policy" value="$(arg lesta_fusion_policy)"/>
    <arg name="lesta_map_source" value="$(arg lesta_map_source)"/>
    <arg name="lesta_probability_layer" value="$(arg lesta_probability_layer)"/>
    <arg name="lesta_binary_layer" value="$(arg lesta_binary_layer)"/>
    <arg name="launch_local_control" value="$(arg launch_local_control)"/>
    <arg name="enable_map_blind_spot_patch" value="$(arg enable_map_blind_spot_patch)"/>
    <arg name="spawn_x" value="$(arg simulation_spawn_x)"/>
    <arg name="spawn_y" value="$(arg simulation_spawn_y)"/>
    <arg name="spawn_z" value="$(eval float(arg('simulation_spawn_z')) + float(arg('spawn_z_offset')))"/>
    <arg name="spawn_yaw" value="$(arg spawn_yaw)"/>
  </include>

  <!-- Compact but replay-complete diagnostic profile. Intermediate LeSTA scan
       products are intentionally omitted because they can be regenerated from
       /velodyne_points; this materially reduces storage for 10-minute warmups. -->
  <node if="$(arg record_diagnostic_bag)" pkg="rosbag" type="record"
        name="map_test_nav_diagnostic_recorder" output="screen" required="true"
        args="--lz4 --split --size=$(arg diagnostic_bag_split_size_mb) --buffsize=$(arg diagnostic_bag_buffsize_mb) -o $(arg diagnostic_bag_prefix) /velodyne_points /tf /tf_static /gazebo/model_states /odom /laser_odom_to_init /aft_mapped_to_init /laser_cloud_map /lesta/mapping/traversability /lesta/mapping/traversability_grid_map /global_planning_node/fused_traversability_cloud /global_planning_node/global_path /goal /cmd_vel /rosout_agg"/>

  <include file="$(find putn_launch)/launch/map_test_nav_eval.launch">
    <arg name="config_path" value="$(arg config_path)"/>
    <arg name="output_dir" value="$(arg output_dir)"/>
    <arg name="method" value="$(arg method)"/>
    <arg name="use_lesta" value="$(arg use_lesta)"/>
    <arg name="lesta_model_path" value="$(arg lesta_model_path)"/>
    <arg name="lesta_putn_weight" value="$(arg lesta_putn_weight)"/>
    <arg name="lesta_weight" value="$(arg lesta_weight)"/>
    <arg name="lesta_unknown_penalty" value="$(arg lesta_unknown_penalty)"/>
    <arg name="lesta_risk_threshold" value="$(arg lesta_risk_threshold)"/>
    <arg name="lesta_fusion_policy" value="$(arg lesta_fusion_policy)"/>
    <arg name="lesta_map_source" value="$(arg lesta_map_source)"/>
    <arg name="require_lesta_ready" value="$(arg require_lesta_ready)"/>
    <arg name="lesta_readiness_timeout_s" value="$(arg lesta_readiness_timeout_s)"/>
    <arg name="lesta_map_topic" value="$(arg lesta_map_topic)"/>
    <arg name="lesta_probability_layer" value="$(arg lesta_probability_layer)"/>
    <arg name="lesta_binary_layer" value="$(arg lesta_binary_layer)"/>
    <arg name="scene" value="$(arg scene)"/>
    <arg name="warmup_coordinate_scale" value="$(arg warmup_coordinate_scale)"/>
    <arg name="task_id" value="$(arg task_id)"/>
    <arg name="runs" value="$(arg runs)"/>
    <arg name="start_x" value="$(arg start_x)"/>
    <arg name="start_y" value="$(arg start_y)"/>
    <arg name="start_z" value="$(arg start_z)"/>
    <arg name="start_label" value="$(arg start_label)"/>
    <arg name="goal_x" value="$(arg goal_x)"/>
    <arg name="goal_y" value="$(arg goal_y)"/>
    <arg name="goal_z" value="$(arg goal_z)"/>
    <arg name="goal_label" value="$(arg goal_label)"/>
    <arg name="initial_delay_s" value="$(arg initial_delay_s)"/>
    <arg name="start_mode" value="$(arg start_mode)"/>
    <arg name="reposition_timeout_s" value="$(arg reposition_timeout_s)"/>
    <arg name="navigation_timeout_s" value="$(arg navigation_timeout_s)"/>
    <arg name="pre_goal_warmup_s" value="$(arg pre_goal_warmup_s)"/>
    <arg name="warmup_mode" value="$(arg warmup_mode)"/>
    <arg name="warmup_cmd_sequence" value="$(arg warmup_cmd_sequence)"/>
    <arg name="warmup_reset_to_start" value="$(arg warmup_reset_to_start)"/>
    <arg name="warmup_end_requires_start" value="$(arg warmup_end_requires_start)"/>
    <arg name="warmup_once" value="$(arg warmup_once)"/>
    <arg name="warmup_bootstrap_enabled" value="$(arg warmup_bootstrap_enabled)"/>
    <arg name="warmup_bootstrap_min_displacement_m" value="$(arg warmup_bootstrap_min_displacement_m)"/>
    <arg name="projection_recovery_distances_m" value="$(arg projection_recovery_distances_m)"/>
    <arg name="projection_recovery_speed_mps" value="$(arg projection_recovery_speed_mps)"/>
    <arg name="projection_recovery_map_settle_s" value="$(arg projection_recovery_map_settle_s)"/>
    <arg name="projection_recovery_scan_angle_deg" value="$(arg projection_recovery_scan_angle_deg)"/>
    <arg name="bidirectional" value="$(arg bidirectional)"/>
    <arg name="session_direction_order_policy" value="$(arg session_direction_order_policy)"/>
    <arg name="max_episode_attempts_per_session" value="$(arg max_episode_attempts_per_session)"/>
    <arg name="rrt_settle_s" value="$(arg rrt_settle_s)"/>
    <arg name="warmup_waypoint_spacing_m" value="$(arg warmup_waypoint_spacing_m)"/>
    <arg name="warmup_waypoint_timeout_s" value="$(arg warmup_waypoint_timeout_s)"/>
    <arg name="warmup_waypoint_retries" value="$(arg warmup_waypoint_retries)"/>
    <arg name="warmup_no_progress_timeout_s" value="$(arg warmup_no_progress_timeout_s)"/>
    <arg name="warmup_min_progress_m" value="$(arg warmup_min_progress_m)"/>
    <arg name="warmup_path_stale_s" value="$(arg warmup_path_stale_s)"/>
    <arg name="warmup_total_timeout_s" value="$(arg warmup_total_timeout_s)"/>
    <arg name="warmup_target_coverage_ratio" value="$(arg warmup_target_coverage_ratio)"/>
    <arg name="enable_heading_recovery" value="$(arg enable_heading_recovery)"/>
    <arg name="heading_recovery_trigger_s" value="$(arg heading_recovery_trigger_s)"/>
    <arg name="heading_recovery_angles_deg" value="$(arg heading_recovery_angles_deg)"/>
    <arg name="heading_recovery_speed" value="$(arg heading_recovery_speed)"/>
    <arg name="lookahead_distance_m" value="$(arg lookahead_distance_m)"/>
    <arg name="path_switch_min_interval_s" value="$(arg path_switch_min_interval_s)"/>
    <arg name="path_max_hold_s" value="$(arg path_max_hold_s)"/>
    <arg name="path_switch_max_heading_deg" value="$(arg path_switch_max_heading_deg)"/>
    <arg name="active_path_end_distance_m" value="$(arg active_path_end_distance_m)"/>
    <arg name="active_path_max_cross_track_m" value="$(arg active_path_max_cross_track_m)"/>
    <arg name="path_origin_max_error_m" value="$(arg path_origin_max_error_m)"/>
    <arg name="control_pose_source" value="$(arg control_pose_source)"/>
    <arg name="localization_drift_fail_m" value="$(arg localization_drift_fail_m)"/>
    <arg name="localization_drift_hold_s" value="$(arg localization_drift_hold_s)"/>
    <arg name="abort_on_start_setup_failure" value="$(arg abort_on_start_setup_failure)"/>
    <arg name="max_excluded_retries_per_direction" value="$(arg max_excluded_retries_per_direction)"/>
    <arg name="resume_incomplete_campaign" value="$(arg resume_incomplete_campaign)"/>
    <arg name="campaign_id" value="$(arg campaign_id)"/>
    <arg name="campaign_seed_csv" value="$(arg campaign_seed_csv)"/>
    <arg name="compensate_goals_with_ground_truth" value="$(arg compensate_goals_with_ground_truth)"/>
    <arg name="abort_on_localization_drift" value="$(arg abort_on_localization_drift)"/>
    <arg name="abort_session_on_severe_localization_drift" value="$(arg abort_session_on_severe_localization_drift)"/>
    <arg name="severe_localization_drift_fail_m" value="$(arg severe_localization_drift_fail_m)"/>
    <arg name="severe_localization_drift_hold_s" value="$(arg severe_localization_drift_hold_s)"/>
    <arg name="tilt_fail_hold_s" value="$(arg tilt_fail_hold_s)"/>
    <arg name="severe_tilt_fail_deg" value="$(arg severe_tilt_fail_deg)"/>
    <arg name="goal_compensation_refresh_distance_m" value="$(arg goal_compensation_refresh_distance_m)"/>
    <arg name="goal_compensation_refresh_yaw_deg" value="$(arg goal_compensation_refresh_yaw_deg)"/>
    <arg name="goal_compensation_refresh_min_interval_s" value="$(arg goal_compensation_refresh_min_interval_s)"/>
    <arg name="goal_compensation_max_refreshes" value="$(arg goal_compensation_max_refreshes)"/>
    <arg name="goal_compensation_max_forced_refreshes" value="$(arg goal_compensation_max_forced_refreshes)"/>
    <arg name="goal_compensation_forced_min_progress_m" value="$(arg goal_compensation_forced_min_progress_m)"/>
    <arg name="control_goal_tolerance_m" value="$(arg control_goal_tolerance_m)"/>
    <arg name="control_goal_mismatch_physical_error_m" value="$(arg control_goal_mismatch_physical_error_m)"/>
    <arg name="control_goal_mismatch_hold_s" value="$(arg control_goal_mismatch_hold_s)"/>
    <arg name="physical_stuck_displacement_m" value="$(arg physical_stuck_displacement_m)"/>
    <arg name="physical_stuck_hold_s" value="$(arg physical_stuck_hold_s)"/>
    <arg name="physical_stuck_max_recoveries" value="$(arg physical_stuck_max_recoveries)"/>
    <arg name="pre_episode_health_timeout_s" value="$(arg pre_episode_health_timeout_s)"/>
    <arg name="pre_episode_health_hold_s" value="$(arg pre_episode_health_hold_s)"/>
    <arg name="pre_episode_max_tilt_deg" value="$(arg pre_episode_max_tilt_deg)"/>
    <arg name="pre_episode_max_tf_gazebo_offset_m" value="$(arg pre_episode_max_tf_gazebo_offset_m)"/>
    <arg name="pre_episode_max_sensor_age_s" value="$(arg pre_episode_max_sensor_age_s)"/>
    <arg name="post_episode_health_check" value="$(arg post_episode_health_check)"/>
    <arg name="lesta_map_max_age_s" value="$(arg lesta_map_max_age_s)"/>
    <arg name="max_consecutive_planning_failures_before_restart" value="$(arg max_consecutive_planning_failures_before_restart)"/>
    <arg name="runtime_metric_sample_period_s" value="$(arg runtime_metric_sample_period_s)"/>
    <arg name="runtime_metric_max_step_m" value="$(arg runtime_metric_max_step_m)"/>
    <arg name="max_angular_speed" value="$(arg max_angular_speed)"/>
    <arg name="require_exclusive_cmd_vel" value="$(arg require_exclusive_cmd_vel)"/>
    <arg name="allow_reverse_following" value="$(arg allow_reverse_following)"/>
    <arg name="reverse_heading_threshold_deg" value="$(arg reverse_heading_threshold_deg)"/>
    <arg name="reverse_exit_threshold_deg" value="$(arg reverse_exit_threshold_deg)"/>
    <arg name="min_follow_linear_speed" value="$(arg min_follow_linear_speed)"/>
    <arg name="min_follow_angular_speed" value="$(arg min_follow_angular_speed)"/>
    <arg name="min_turn_in_place_angular_speed" value="$(arg min_turn_in_place_angular_speed)"/>
    <arg name="rotate_in_place_threshold_deg" value="$(arg rotate_in_place_threshold_deg)"/>
    <arg name="rotate_in_place_exit_threshold_deg" value="$(arg rotate_in_place_exit_threshold_deg)"/>
    <arg name="max_moving_angular_speed" value="$(arg max_moving_angular_speed)"/>
    <arg name="shutdown_on_completion" value="$(arg shutdown_on_completion)"/>
  </include>
</launch>
