Panels:
  - Class: rviz/Displays
    Help Height: 80
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /LeSTA Prediction1
        - /LeSTA Mapping1
      Splitter Ratio: 0.550000011920929
    Tree Height: 309
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz/Time
    Name: Time
    SyncMode: 0
    SyncSource: ""
Preferences:
  PromptSaveOnExit: false
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.3499999940395355
      Cell Size: 1
      Class: rviz/Grid
      Color: 120; 120; 125
      Enabled: true
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: World Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 50
      Reference Frame: world
      Value: true
    - Class: rviz/TF
      Enabled: true
      Filter (blacklist): ""
      Filter (whitelist): ""
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Alpha: 1
      Marker Scale: 0.5
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Tree:
        {}
      Update Interval: 0
      Value: true
    - Alpha: 1
      Class: rviz/Axes
      Enabled: true
      Length: 0.800000011920929
      Name: Robot Axes
      Radius: 0.05999999865889549
      Reference Frame: base_link
      Show Trail: true
      Value: true
    - Alpha: 0.2199999988079071
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz/PointCloud2
      Color: 180; 180; 180
      Color Transformer: Intensity
      Decay Time: 2
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 55; 55; 55
      Name: Raw Velodyne
      Position Transformer: XYZ
      Queue Size: 10
      Selectable: false
      Size (Pixels): 2
      Size (m): 0.02500000037252903
      Style: Points
      Topic: /velodyne_points
      Unreliable: false
      Use Fixed Frame: true
      Use rainbow: false
      Value: true
    - Class: rviz/Group
      Displays:
        - Alpha: 1
          Autocompute Intensity Bounds: false
          Autocompute Value Bounds:
            Max Value: 1
            Min Value: 0
            Value: false
          Axis: Z
          Channel Name: traversability/probability
          Class: rviz/PointCloud2
          Color: 255; 255; 255
          Color Transformer: Intensity
          Decay Time: 0
          Enabled: true
          Invert Rainbow: false
          Max Color: 0; 220; 60
          Max Intensity: 1
          Min Color: 220; 25; 25
          Min Intensity: 0
          Name: Probability
          Position Transformer: XYZ
          Queue Size: 3
          Selectable: true
          Size (Pixels): 3
          Size (m): 0.07999999821186066
          Style: Spheres
          Topic: /lesta/prediction/traversability_cloud
          Unreliable: false
          Use Fixed Frame: true
          Use rainbow: false
          Value: true
        - Alpha: 0.6499999761581421
          Autocompute Intensity Bounds: true
          Autocompute Value Bounds:
            Max Value: 2
            Min Value: -0.5
            Value: true
          Axis: Z
          Channel Name: z
          Class: rviz/PointCloud2
          Color: 210; 210; 210
          Color Transformer: FlatColor
          Decay Time: 0
          Enabled: false
          Invert Rainbow: false
          Max Color: 255; 255; 255
          Min Color: 0; 0; 0
          Name: Rasterized Input
          Position Transformer: XYZ
          Queue Size: 3
          Selectable: false
          Size (Pixels): 2
          Size (m): 0.03999999910593033
          Style: Points
          Topic: /lesta/prediction/scan_rasterized
          Unreliable: false
          Use Fixed Frame: true
          Use rainbow: false
          Value: false
      Enabled: true
      Name: LeSTA Prediction
    - Class: rviz/Group
      Displays:
        - Alpha: 0.8199999928474426
          Autocompute Intensity Bounds: false
          Autocompute Value Bounds:
            Max Value: 1
            Min Value: 0
            Value: false
          Axis: Z
          Channel Name: traversability/probability
          Class: rviz/PointCloud2
          Color: 255; 255; 255
          Color Transformer: Intensity
          Decay Time: 0
          Enabled: true
          Invert Rainbow: false
          Max Color: 0; 220; 60
          Max Intensity: 1
          Min Color: 220; 25; 25
          Min Intensity: 0
          Name: Instantaneous Probability (fusion input)
          Position Transformer: XYZ
          Queue Size: 3
          Selectable: true
          Size (Pixels): 2
          Size (m): 0.07000000029802322
          Style: Spheres
          Topic: /lesta/mapping/traversability
          Unreliable: false
          Use Fixed Frame: true
          Use rainbow: false
          Value: true
        - Alpha: 0.8199999928474426
          Autocompute Intensity Bounds: false
          Autocompute Value Bounds:
            Max Value: 1
            Min Value: 0
            Value: false
          Axis: Z
          Channel Name: mapping/probability
          Class: rviz/PointCloud2
          Color: 255; 255; 255
          Color Transformer: Intensity
          Decay Time: 0
          Enabled: false
          Invert Rainbow: false
          Max Color: 0; 220; 60
          Max Intensity: 1
          Min Color: 220; 25; 25
          Min Intensity: 0
          Name: Accumulated Probability (diagnostic only)
          Position Transformer: XYZ
          Queue Size: 3
          Selectable: true
          Size (Pixels): 2
          Size (m): 0.07000000029802322
          Style: Spheres
          Topic: /lesta/mapping/traversability
          Unreliable: false
          Use Fixed Frame: true
          Use rainbow: false
          Value: false
        - Class: rviz/Marker
          Enabled: true
          Marker Topic: /lesta/mapping/mapping_region
          Name: Mapping Region
          Namespaces:
            {}
          Queue Size: 10
          Value: true
      Enabled: true
      Name: LeSTA Mapping
    - Alpha: 0.6499999761581421
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 2
        Min Value: -0.5
        Value: true
      Axis: Z
      Channel Name: z
      Class: rviz/PointCloud2
      Color: 255; 255; 255
      Color Transformer: AxisColor
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Name: PUTN Fused Traversability
      Position Transformer: XYZ
      Queue Size: 3
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.05000000074505806
      Style: Points
      Topic: /global_planning_node/fused_traversability_cloud
      Unreliable: false
      Use Fixed Frame: true
      Use rainbow: true
      Value: true
  Enabled: true
  Global Options:
    Background Color: 25; 25; 28
    Default Light: true
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 24
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Field of View: 0.785398006439209
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05000000074505806
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: 0.7200000286102295
      Target Frame: world
      Yaw: 0.7799999713897705
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: true
  QMainWindow State: 
  Selection:
    collapsed: false
  Time:
    collapsed: false
  Views:
    collapsed: false
  Width: 1500
  X: 80
  Y: 27
